# Auto-detect text files and convert line endings
* text=auto eol=lf

# Shell scripts should always use LF and be executable
*.sh text eol=lf
*.sh export-subst

# Windows batch files use CRLF
*.bat text eol=crlf

# Configuration files
*.json text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cpp text eol=lf
*.h text eol=lf

# Documentation
*.md text eol=lf

# License
LICENSE text eol=lf