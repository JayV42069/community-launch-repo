# ┌─────────────────────────────────────────────────────────────────────┐
# │ Education Boilerplate — Environment Variables Template              │
# │ Copy to .env.local and fill in values before running `pnpm dev`     │
# └─────────────────────────────────────────────────────────────────────┘

# ── WebSocket Relay ───────────────────────────────────────────────────
# The Node.js server (server/index.js) listens here.
# Vite proxies /ws to this port automatically.
WS_RELAY_PORT=8081
TCP_BRIDGE_PORT=8080

# ── Auth (optional — mirrors moon-dev-web Clerk+Stripe gate) ───────────
# When WANT_AUTH=true, the WS server requires a valid JWT token in the
# WebSocket query string (?token=eyJ...) or Authorization header.
# Set to false for zero-config learning mode (mock data only).
WANT_AUTH=false

# In dev mode, the server accepts any JWT that decodes to a valid payload.
# In production, set this to your Clerk/Stripe backend URL so the relay
# can cross-check subscription status.
AUTH_BACKEND_URL=http://localhost:8000

# ── Mock Data ─────────────────────────────────────────────────────────
# Symbol streamed by the mock candle generator when no C++ bridge is
# connected. Change to any MT5 symbol (e.g. AAPL, BTCUSD, GBPJPY).
MOCK_SYMBOL=XAUUSD
# How often (ms) mock candles are generated.
MOCK_INTERVAL_MS=1000
